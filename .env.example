# Docker Compose (red interna sanos-net)
# MySQL expuesto en el host en 3307 -> contenedor mysql:3306
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=sanos
MYSQL_PASSWORD=sanos_pwd

# Mismo secreto en IAM y gateway (Compose ya lo define por defecto)
SANOS_JWT_SECRET=sanos-y-salvos-super-secret-key-at-least-32-chars

# Media: volumen persistente en el contenedor
SANOS_MEDIA_UPLOAD_DIR=/data/uploads
